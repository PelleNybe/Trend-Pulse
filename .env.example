# ====================== TRENDPULSE Related ======================
# TRENDPULSE Host address, e.g.: 0.0.0.0 or 127.0.0.1
HOST=0.0.0.0
# TRENDPULSE Port, default is 5000
PORT=5000

# ====================== Database Configuration ======================
# Database Host, e.g., localhost or 127.0.0.1
DB_HOST=your_db_host
# Database Port, default is 3306
DB_PORT=3306
# Database Username
DB_USER=your_db_user
# Database Password
DB_PASSWORD=your_db_password
# Database Name
DB_NAME=your_db_name
# Database Charset, utf8mb4 recommended for emoji compatibility
DB_CHARSET=utf8mb4
# Database Dialect, mysql or postgresql
DB_DIALECT=postgresql


# ====================== Redis Configuration ======================
# Redis Host, e.g., localhost or redis
REDIS_HOST=localhost
# Redis Port, default is 6379
REDIS_PORT=6379
# Redis DB index
REDIS_DB=0
# Full SQLAlchemy / async database URL override (optional)
DATABASE_URL=

# ======================= LLM Related =======================
# You can change the API used by the LLM for each section, as long as it is compatible with the OpenAI request format. Just define KEY, BASE_URL, and MODEL_NAME to use it normally.

# Insight Agent (e.g., kimi-k2, gpt-4o, or any OpenAI-compatible model)
INSIGHT_ENGINE_API_KEY=
INSIGHT_ENGINE_BASE_URL=
INSIGHT_ENGINE_MODEL_NAME=

# Media Agent (e.g., gemini-2.5-pro or any OpenAI-compatible model)
MEDIA_ENGINE_API_KEY=
MEDIA_ENGINE_BASE_URL=
MEDIA_ENGINE_MODEL_NAME=

# Query Agent (e.g., gpt-4o or any OpenAI-compatible model)
QUERY_ENGINE_API_KEY=
QUERY_ENGINE_BASE_URL=
QUERY_ENGINE_MODEL_NAME=

# Report Agent (e.g., gemini-2.5-pro or any OpenAI-compatible model)
# Note: Report Agent requires relatively strong model capabilities. If the final report has blank charts/abnormal paragraphs, please try changing to a stronger model.
REPORT_ENGINE_API_KEY=
REPORT_ENGINE_BASE_URL=
REPORT_ENGINE_MODEL_NAME=

# MindSpider Agent (recommended gpt-4, official application URL: https://platform.openai.com/)
MINDSPIDER_API_KEY=
MINDSPIDER_BASE_URL=
MINDSPIDER_MODEL_NAME=

# Forum Host (recommended gpt-4, official application URL: https://www.openai.com)
FORUM_HOST_API_KEY=
FORUM_HOST_BASE_URL=
FORUM_HOST_MODEL_NAME=

# SQL Keyword Optimizer (recommended gpt-4, official application URL: https://www.openai.com)
KEYWORD_OPTIMIZER_API_KEY=
KEYWORD_OPTIMIZER_BASE_URL=
KEYWORD_OPTIMIZER_MODEL_NAME=

# ================== Network Tools Configuration ====================
# Tavily API Key, used for Tavily web search, application URL: https://www.tavily.com/
TAVILY_API_KEY=

# Web search tool type, supports BochaAPI or AnspireAPI, default is AnspireAPI
SEARCH_TOOL_TYPE=AnspireAPI

# Anspire AI Search API (https://open.anspire.cn/)
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search
ANSPIRE_API_KEY=

# System API Key for securing sensitive operations (shutdown, start, config updates)
ADMIN_API_KEY=

# Flask Secret Key for session signing and security. MUST be a long, random string.
SECRET_KEY=

# Bocha AI Search API (used for Bocha multimodal search, although the key name here is Web Search, it actually requires AI Search, application URL: https://open.bochaai.com/)
BOCHA_BASE_URL=https://api.bocha.cn/v1/ai-search
BOCHA_WEB_SEARCH_API_KEY=
BOCHA_API_KEY=

# ================== Agent & Report Runtime Tuning ====================
OUTPUT_DIR=reports
SAVE_INTERMEDIATE_STATES=True
MAX_REFLECTIONS=2
MAX_CONTENT_LENGTH=500000
SEARCH_CONTENT_MAX_LENGTH=20000
MAX_SEARCH_RESULTS_FOR_LLM=0
DEFAULT_SEARCH_HOT_CONTENT_LIMIT=100
DEFAULT_SEARCH_TOPIC_GLOBALLY_LIMIT_PER_TABLE=50
DEFAULT_SEARCH_TOPIC_BY_DATE_LIMIT_PER_TABLE=100
DEFAULT_GET_COMMENTS_FOR_TOPIC_LIMIT=500
DEFAULT_SEARCH_TOPIC_ON_PLATFORM_LIMIT=200
CHAPTER_OUTPUT_DIR=final_reports/chapters
DOCUMENT_IR_OUTPUT_DIR=final_reports/ir
JSON_ERROR_LOG_DIR=logs/json_errors
LOG_FILE=logs/report.log
TEMPLATE_DIR=ReportEngine/report_template
CHAPTER_JSON_MAX_ATTEMPTS=2
WEBHOOK_ENDPOINTS=[]